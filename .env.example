HF_TOKEN=your_hugging_face_token_here

# PostgreSQL & pgvector Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=news_recommender

# Optional: Direct database URL (overrides individual variables above)
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/news_recommender

# Optional: Remote Cloud GPU Worker URL (Google Colab with T4 GPU)
# Paste the Cloudflare Tunnel URL printed by the Colab worker notebook here:
# REMOTE_MODEL_URL=https://your-tunnel-name.trycloudflare.com
# Shared secret for that worker -- must equal the WORKER_TOKEN Colab secret.
# Leave blank only if you accept an unauthenticated public GPU.
# REMOTE_MODEL_TOKEN=your_worker_token_here

# CSV upload limits (MB). The live embedding-only path accepts ~100k-row files;
# the precomputed path stays small because it cross-encodes every article.
# NEWSREC_MAX_UPLOAD_MB=50
# NEWSREC_MAX_LIVE_UPLOAD_MB=600
